# ==============================================================================
# ÉCOSYSTÈME ALPHABETTE — CONFIGURATION SOUVERAINE MISTRAL AI (RGPD EXCLUSIF)
# ==============================================================================
# Toutes les applications de la suite Alphabette reposent exclusivement sur Mistral AI.
# Hébergement 100% européen, conformité RGPD native, zéro réutilisation pour l'entraînement.

# 1. URL de base de l'IA (Mistral Cloud ou Ollama Mac Metal local)
# Production : https://api.mistral.ai/v1
# Local Mac : http://localhost:11434/v1
AI_BASE_URL="https://api.mistral.ai/v1"

# 2. Clé API propriétaire Alphabette (fournie pour les 7 jours d'essai et l'offre Confort)
# Les utilisateurs en mode BYOK renseignent leur propre clé via l'interface dédiée.
AI_API_KEY="your_mistral_api_key_here"

# 3. Modèle Mistral par défaut (mistral-small-latest, mistral-large-latest, codestral-latest)
MISTRAL_MODEL="mistral-small-latest"

# 4. Modèle Mistral Multimodal / Vision (pour documents scannés, tickets, états des lieux)
MISTRAL_VISION_MODEL="pixtral-12b-2409"

# ==============================================================================
# CONFIGURATION ENVIRONNEMENT HÉBERGEMENT
# ==============================================================================
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
